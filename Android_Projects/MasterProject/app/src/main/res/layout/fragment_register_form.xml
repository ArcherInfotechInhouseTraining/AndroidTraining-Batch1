<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterForm">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textview1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Archer Infotech"
                android:gravity="center"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/textview2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Register Form"
                android:gravity="center"
                android:textSize="20sp"
                android:layout_below="@id/textview1"/>

            <LinearLayout
                android:id="@+id/firstlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_below="@id/textview2"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Image"
                    android:layout_marginStart="10dp"/>

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="137dp"
                    android:layout_marginStart="60dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageview"
                            android:layout_width="wrap_content"
                            android:layout_height="100dp"
                            android:src="@drawable/register"/>
                        <ImageView
                            android:id="@+id/successimage"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:visibility="gone"
                            android:src="@drawable/baseline_check_circle_24"
                            android:layout_gravity="center"/>

                    </FrameLayout>

                    <Button
                        android:id="@+id/uploadbutton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Choose File"
                        android:textSize="10sp"
                        android:layout_marginStart="35dp"
                        android:layout_marginTop="-30dp"
                        android:padding="5dp"
                        android:background="#ACA7A7"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Image Size Less Than 5 MB)"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"/>

            </LinearLayout>
            <EditText
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter Student Name"
                android:textSize="15dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/firstlayout"/>

            <EditText
                android:id="@+id/fname"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter Father Name"
                android:textSize="15dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/name"/>

            <EditText
                android:id="@+id/mname"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter Mother Name"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/fname"/>


            <EditText
                android:id="@+id/dob"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter DOB"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/mname"/>


            <EditText
                android:id="@+id/gmail"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter gmail"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/dob"/>


            <EditText
                android:id="@+id/choose"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="Choose"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/gmail"/>


            <EditText
                android:id="@+id/department"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Enter Dapartment Name"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/choose"/>


            <EditText
                android:id="@+id/no"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Moile no"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/choose"/>

            <TextView
                android:id="@+id/timetext"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/btn"
                android:hint="enter current time"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:gravity="center"
                android:layout_below="@id/no"/>


            <LinearLayout
                android:id="@+id/layout10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="30dp"
                android:orientation="horizontal"
                android:layout_below="@id/timetext">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender "
                    android:gravity="start"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center"/>
                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/maleradio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="male"
                        android:layout_marginStart="20dp"/>
                    <RadioButton
                        android:id="@+id/femaleradio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="female"
                        android:layout_marginStart="20dp"/>
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/addresstext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permanent Address"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_below="@id/layout10"
                android:gravity="center"/>

            <EditText
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="State"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/addresstext"/>

            <EditText
                android:id="@+id/pstate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="City"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/state"/>

            <EditText
                android:id="@+id/zipcode"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="Zipcode"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/pstate"/>


            <EditText
                android:id="@+id/mb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" Mobile no"
                android:textSize="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/zipcode"/>

            <TextView
                android:id="@+id/tempaddresstext"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Temporary Address"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_below="@id/mb"/>

            <LinearLayout
                android:id="@+id/radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@id/tempaddresstext"
                android:layout_marginStart="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Same as Permanent Address "
                    android:gravity="start"
                    android:layout_marginStart="10dp"/>
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/tempstate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="State"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/radio"/>


            <EditText
                android:id="@+id/tempcity"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="City"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/tempstate"/>

            <EditText
                android:id="@+id/tempzip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint="Zipcode"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_below="@id/tempcity"/>



            <EditText
                android:id="@+id/moileno"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:hint=" moile no"
                android:textSize="15dp"
                android:background="@drawable/btn"
                android:gravity="center"
                android:layout_marginStart="30dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                android:layout_below="@id/tempzip"/>


            <Button
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:layout_marginStart="90dp"
                android:layout_marginTop="20dp"
                android:layout_below="@id/moileno"
                android:layout_marginEnd="?attr/actionBarSize"/>

        </RelativeLayout>

    </ScrollView>

</FrameLayout>