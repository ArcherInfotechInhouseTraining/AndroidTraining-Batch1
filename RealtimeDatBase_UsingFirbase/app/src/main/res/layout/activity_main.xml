<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Relatime Databse \n Using Firebase"
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/userData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your id"
        android:gravity="center_horizontal"
        android:layout_margin="10dp"
        android:layout_below="@id/textview"/>

    <EditText
        android:id="@+id/userName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your name"
        android:gravity="center_horizontal"
        android:layout_below="@id/userData"
        android:layout_margin="10dp"/>

    <EditText
        android:id="@+id/mbEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your mobile number"
        android:gravity="center_horizontal"
        android:layout_below="@id/userName"
        android:layout_margin="10dp"/>

    <EditText
        android:id="@+id/addressEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Address"
        android:gravity="center_horizontal"
        android:layout_margin="10dp"
        android:layout_below="@id/mbEditText"/>

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_below="@id/addressEditText">

        <Button
            android:id="@+id/readBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Data"
            android:textColor="@color/white"
            android:backgroundTint="#2BA02D"/>

        <Button
            android:id="@+id/updateBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Data"
            android:layout_marginStart="20dp"
            android:textColor="@color/white"
            android:backgroundTint="#2C40B0"/>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_below="@id/linearLayout1">


        <Button
            android:id="@+id/insertBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insert Data"
            android:textColor="@color/white"
            android:backgroundTint="#9C27B0"/>

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Data"
            android:textColor="@color/white"
            android:layout_marginStart="20dp"
            android:backgroundTint="#BB1F1F"/>

    </LinearLayout>

    <TextView
        android:id="@+id/textId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="m"
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_below="@id/linearLayout2"/>

    <TextView
        android:id="@+id/textName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="n"
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_below="@id/textId"/>

    <TextView
        android:id="@+id/textAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="nn"
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_below="@id/textName"/>

    <TextView
        android:id="@+id/textmb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="nnn"
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_below="@id/textAddress"/>

</RelativeLayout>